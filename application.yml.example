# ==============================================================================
# Enterprise Lavalink v4 Configuration
#
# PENTING / CRITICAL NOTE TENTANG OUTPUT SUARA:
# 1. Discord sekarang mewajibkan enkripsi suara end-to-end (protokol DAVE).
#    Gunakan Lavalink Server versi v4.2.0 atau lebih baru! Versi lama (< v4.2.0)
#    akan menyebabkan "output suara tidak ada" karena Discord menolak paket audio unencrypted.
# 2. Gunakan dev.lavalink.youtube:youtube-plugin:1.18.2 (atau terbaru) dengan konfigurasi
#    plugins.youtube aktif agar pemutaran YouTube & LavaSrc (Spotify/Apple Music) berjalan normal.
# ==============================================================================

server:
  port: 2333
  address: 0.0.0.0
  http2:
    enabled: true

lavalink:
  plugins:
    # LavaSrc Plugin for Spotify, Apple Music, Deezer, Tidal, Yandex Music
    - dependency: "com.github.topi314.lavasrc:lavasrc-plugin:4.3.0"
      repository: "https://maven.lavalink.dev/releases"
    # LavaSearch Plugin for Cross-Platform Query Resolution
    - dependency: "com.github.topi314.lavasearch:lavasearch-plugin:1.0.0"
      repository: "https://maven.lavalink.dev/releases"
    # SponsorBlock Plugin for Auto-Skipping Non-Music Segments
    - dependency: "com.github.topi314.sponsorblock:sponsorblock-plugin:3.0.1"
      repository: "https://maven.lavalink.dev/releases"
    # Official YouTube Source Plugin (v4.2.0+ compatible)
    - dependency: "dev.lavalink.youtube:youtube-plugin:1.18.2"
      repository: "https://maven.lavalink.dev/releases"
      snapshot: false

  server:
    password: "youshallnotpass"
    sources:
      youtube: false # Dikelola melalui plugin resmi dev.lavalink.youtube
      bandcamp: true
      soundcloud: true
      twitch: true
      vimeo: true
      http: true
      local: false
    filters:
      volume: true
      equalizer: true
      karaoke: true
      timescale: true
      tremolo: true
      vibrato: true
      distortion: true
      rotation: true
      channelMix: true
      lowPass: true
    bufferDurationMs: 400
    frameBufferDurationMs: 5000
    opusEncodingQuality: 10
    resamplingQuality: HIGH
    trackStuckThresholdMs: 10000
    useSeekGhosting: true
    playerUpdateInterval: 5
    youtubeSearchEnabled: true
    soundcloudSearchEnabled: true
    gc-warnings: true

plugins:
  # Konfigurasi Resmi YouTube Source Plugin
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    clients:
      - MUSIC
      - ANDROID
      - WEB
      - TVHTML5EMBEDDED
    # Catatan: Jika menggunakan IP VPS/Datacenter yang terkena pembatasan bot YouTube (429/Sign-in required),
    # Anda dapat mengaktifkan opsi OAuth2 atau PO-Token di bawah ini:
    # oauth:
    #   enabled: true
    #   skipInitialization: false
    # potoken:
    #   token: "YOUR_PO_TOKEN"
    #   visitorData: "YOUR_VISITOR_DATA"

  # Konfigurasi LavaSrc Multi-Platform (Spotify, Apple Music, Deezer, Tidal)
  lavasrc:
    providers:
      - "ytsearch:\"%ISRC%\""
      - "ytmsearch:\"%ISRC%\""
      - "ytsearch:%QUERY%"
      - "scsearch:%QUERY%" # Fallback SoundCloud
    sources:
      spotify: true
      applemusic: true
      deezer: true
      tidal: true
      yandexmusic: false
      flowerytts: false
      vkmusic: false
    spotify:
      clientId: "YOUR_SPOTIFY_CLIENT_ID"
      clientSecret: "YOUR_SPOTIFY_CLIENT_SECRET"
      spdc: "YOUR_SPOTIFY_SPDC_COOKIE"
      countryCode: "ID"
      playlistLoadLimit: 100
      albumLoadLimit: 50
    applemusic:
      countryCode: "ID"
      mediaAPIToken: "YOUR_APPLE_MUSIC_API_TOKEN"
      playlistLoadLimit: 100
      albumLoadLimit: 50
    deezer:
      masterDecryptionKey: "YOUR_DEEZER_DECRYPTION_KEY"
    tidal:
      countryCode: "ID"
      token: "YOUR_TIDAL_TOKEN"

  # SponsorBlock Configuration
  sponsorblock:
    categories:
      - "sponsor"
      - "selfpromo"
      - "interaction"
      - "intro"
      - "outro"
      - "preview"
      - "music_offtopic"
      - "filler"

logging:
  file:
    path: ./logs/lavalink.log
  level:
    root: INFO
    lavalink: INFO
    moe.kyokobot.koe.internal.dave: INFO
